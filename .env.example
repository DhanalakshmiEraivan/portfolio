# Copy this file to .env and enter your SMTP provider details. Never commit .env.
PORT=3000
NODE_ENV=production

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

MAIL_FROM="QuadraFroyn Website <no-reply@example.com>"
MAIL_TO=inbox@example.com
